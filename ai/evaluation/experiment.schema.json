{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.v0.1",
  "title": "AI Commerce Experiment Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "dataset_version",
    "dataset_manifest_hash",
    "baseline",
    "candidate",
    "metrics",
    "latency_cost",
    "error_analysis",
    "decision"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "split_version": {
      "type": ["string", "null"]
    },
    "code_commit": {
      "type": ["string", "null"]
    },
    "seed": {
      "type": ["integer", "null"]
    },
    "baseline": {
      "type": "object"
    },
    "candidate": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "minProperties": 1
    },
    "latency_cost": {
      "type": "object"
    },
    "slice_results": {
      "type": "object"
    },
    "error_analysis": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "PENDING",
        "ADOPTED",
        "REJECTED",
        "CONDITIONAL"
      ]
    },
    "decision_reason": {
      "type": ["string", "null"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}